+
+Gow3PadReplayState& GetGow3PadReplayState() {
+    static Gow3PadReplayState state;
+    return state;
+}
+
+template <typename T>
+bool ReadReplayValue(std::ifstream& file, T& value) {
+    return static_cast<bool>(file.read(reinterpret_cast<char*>(&value), sizeof(value)));
+}
+
+template <typename T>
+void WriteReplayValue(std::ofstream& file, const T& value) {
+    file.write(reinterpret_cast<const char*>(&value), sizeof(value));
+}
+
+bool LoadGow3PadReplay(Gow3PadReplayState& state) {
+    std::ifstream file{state.path, std::ios::binary};
+    if (!file.is_open()) {
+        LOG_ERROR(Lib_Pad, "GOW3_PAD_REPLAY_V1 failed to open replay file: {}",
+                  state.path.string());
+        return false;
+    }
+
+    std::array<char, Gow3PadReplayMagic.size()> magic{};
+    file.read(magic.data(), magic.size());
+    u32 version{};
+    u32 pad_data_size{};
+    if (!file || magic != Gow3PadReplayMagic || !ReadReplayValue(file, version) ||
+        !ReadReplayValue(file, pad_data_size) || version != Gow3PadReplayVersion ||
+        pad_data_size != sizeof(OrbisPadData)) {
+        LOG_ERROR(Lib_Pad,
+                  "GOW3_PAD_REPLAY_V1 invalid replay header (version={}, pad_data_size={}, expected={})",
+                  version, pad_data_size, sizeof(OrbisPadData));
+        return false;
+    }
+
+    state.replay_calls.clear();
+    while (true) {
+        Gow3PadReplayCall call{};
+        if (!ReadReplayValue(file, call.requested_num)) {
+            if (file.eof()) {
+                break;
+            }
+            return false;
+        }
+        if (!ReadReplayValue(file, call.returned_num) || call.requested_num < 1 ||
+            call.requested_num > ORBIS_PAD_MAX_DATA_NUM || call.returned_num < 0 ||
+            call.returned_num > call.requested_num) {
+            LOG_ERROR(Lib_Pad, "GOW3_PAD_REPLAY_V1 invalid call record");
+            return false;
+        }
+        const size_t bytes = static_cast<size_t>(call.returned_num) * sizeof(OrbisPadData);
+        if (bytes != 0 && !file.read(reinterpret_cast<char*>(call.data.data()), bytes)) {
+            LOG_ERROR(Lib_Pad, "GOW3_PAD_REPLAY_V1 truncated replay payload");
+            return false;
+        }
+        state.replay_calls.push_back(std::move(call));
+    }
+
+    if (state.replay_calls.empty()) {
+        LOG_ERROR(Lib_Pad, "GOW3_PAD_REPLAY_V1 replay file contains no pad reads");
+        return false;
+    }
+    state.replay_cursor = 0;
+    state.divergence_reported = false;
+    LOG_INFO(Lib_Pad, "GOW3_PAD_REPLAY_V1 loaded {} pad-read calls from {}",
+             state.replay_calls.size(), state.path.string());
+    return true;
+}
+
+void ResetGow3PadReplayLocked(Gow3PadReplayState& state) {
+    if (state.record_file.is_open()) {
+        state.record_file.flush();
+        state.record_file.close();
+    }
+    state.mode = Gow3PadReplayMode::Disabled;
+    state.path.clear();
+    state.replay_calls.clear();
+    state.replay_cursor = 0;
+    state.capture_active = false;
+    state.divergence_reported = false;
+}
+
+} // namespace

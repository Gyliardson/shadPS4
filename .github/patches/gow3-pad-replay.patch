+bool PrepareGow3BenchmarkPadCapture() {
+    auto& state = GetGow3PadReplayState();
+    std::scoped_lock lock{state.mutex};
+    ResetGow3PadReplayLocked(state);
+
+    const char* record_path = std::getenv("SHADPS4_GOW3_PAD_RECORD");
+    const char* replay_path = std::getenv("SHADPS4_GOW3_PAD_REPLAY");
+    const bool record_enabled = record_path != nullptr && record_path[0] != '\0';
+    const bool replay_enabled = replay_path != nullptr && replay_path[0] != '\0';
+    if (record_enabled && replay_enabled) {
+        LOG_ERROR(Lib_Pad, "GOW3_PAD_REPLAY_V1 record and replay are both configured");
+        return false;
+    }
+    if (!record_enabled && !replay_enabled) {
+        return true;
+    }
+
+    if (record_enabled) {
+        state.mode = Gow3PadReplayMode::Record;
+        state.path = std::filesystem::path{record_path};
+        std::error_code ec;
+        std::filesystem::create_directories(state.path.parent_path(), ec);
+        state.record_file.open(state.path, std::ios::binary | std::ios::trunc);
+        if (!state.record_file.is_open()) {
+            LOG_ERROR(Lib_Pad, "GOW3_PAD_REPLAY_V1 failed to create record file: {}",
+                      state.path.string());
+            ResetGow3PadReplayLocked(state);
+            return false;
+        }
+        state.record_file.write(Gow3PadReplayMagic.data(), Gow3PadReplayMagic.size());
+        WriteReplayValue(state.record_file, Gow3PadReplayVersion);
+        const u32 pad_data_size = sizeof(OrbisPadData);
+        WriteReplayValue(state.record_file, pad_data_size);
+        LOG_INFO(Lib_Pad, "GOW3_PAD_REPLAY_V1 recording to {}", state.path.string());
+        return static_cast<bool>(state.record_file);
+    }
+
+    state.mode = Gow3PadReplayMode::Replay;
+    state.path = std::filesystem::path{replay_path};
+    if (!LoadGow3PadReplay(state)) {
+        ResetGow3PadReplayLocked(state);
+        return false;
+    }
+    return true;
+}
+
+void SetGow3BenchmarkPadCaptureActive(bool active) {
+    auto& state = GetGow3PadReplayState();
+    std::scoped_lock lock{state.mutex};
+    state.capture_active = active;
+    if (!active && state.record_file.is_open()) {
+        state.record_file.flush();
+        state.record_file.close();
+        LOG_INFO(Lib_Pad, "GOW3_PAD_REPLAY_V1 recording finalized: {}", state.path.string());
+    }
+    if (!active && state.mode == Gow3PadReplayMode::Replay) {
+        LOG_INFO(Lib_Pad, "GOW3_PAD_REPLAY_V1 replay stopped at {}/{} pad-read calls",
+                 state.replay_cursor, state.replay_calls.size());
+    }
+}
